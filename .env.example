# Spring Boot does not load this file automatically; export variables or use your IDE's environment settings.
SPRING_PROFILES_ACTIVE=local

# Keep disabled until the corresponding adapters are implemented and configured.
TELEGRAM_ENABLED=false
OPENAI_ENABLED=false
NOTIFICATIONS_ENABLED=false

# Fill locally when implementing T03/T07. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
OPENAI_API_KEY=
OPENAI_MODEL=

# Local PostgreSQL. Replace this example password locally before starting Compose.
POSTGRES_DB=financeconsultante
POSTGRES_USER=financeconsultante
POSTGRES_PASSWORD=local-example-change-me
POSTGRES_PORT=5432

# For prod set DATABASE_URL (jdbc:postgresql://...), DATABASE_USERNAME and DATABASE_PASSWORD.
