# Spring Boot does not load this file automatically; export variables or use your IDE's environment settings.
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Keep disabled until the corresponding adapters are configured.
EXCHANGE_RATES_ENABLED=false
MOBILE_API_ENABLED=false
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=ID
# Explicit migration binding: both values are required together; never infer access from email.
FIREBASE_LEGACY_UID=
FIREBASE_LEGACY_MEMBER_ID=
# Existing ADC/service account file outside this repository; do not paste private JSON here.
GOOGLE_APPLICATION_CREDENTIALS=

# Mobile API uses verified Firebase ID tokens; obsolete static token settings have no effect.
# OpenAI variables below are only for explicitly selected provider evaluation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-2024-07-18
OPENAI_REQUEST_TIMEOUT=10s
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=256
OPENAI_DAILY_REQUEST_LIMIT=50
CURRENCYLAYER_ACCESS_KEY=

# Local PostgreSQL. Replace this example password locally before starting Compose.
POSTGRES_DB=financeconsultante
POSTGRES_USER=financeconsultante
POSTGRES_PASSWORD=local-example-change-me
POSTGRES_PORT=5432

# For prod set DATABASE_URL (jdbc:postgresql://...), DATABASE_USERNAME and DATABASE_PASSWORD.
